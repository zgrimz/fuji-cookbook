// Signing and identity for every target, in one place.
//
// The defaults are the shipping app's. To build under your own Apple developer team, copy
// Local.example.xcconfig to Local.xcconfig (git-ignored) and override what you need there.
//
// APP_IDENTIFIER_BASE names the bundle ids, the App Group, the iCloud container and the shared
// Keychain group. Changing it for an existing install relocates the library, the logs, the
// settings and the stored API keys, so the shipping value never changes.

DEVELOPMENT_TEAM = MWW68W9GDA

// The version every target ships with. App Store Connect refuses an upload whose app and Share
// Extension disagree, so both read the two numbers from here rather than from per-target settings.
MARKETING_VERSION = 1.2
CURRENT_PROJECT_VERSION = 18
APP_IDENTIFIER_BASE = xyz.grovehouse.fujicookbookapp
APP_GROUP_IDENTIFIER = group.$(APP_IDENTIFIER_BASE)
ICLOUD_CONTAINER_IDENTIFIER = iCloud.$(APP_IDENTIFIER_BASE)

#include? "Local.xcconfig"
